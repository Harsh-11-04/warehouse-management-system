# ---------------------------------------------------
# JattKart POS Backend - Environment Configuration
# ---------------------------------------------------
# Copy this file to .env and fill in your actual values.
# NEVER commit real credentials to version control.
# ---------------------------------------------------

PORT=4000

# MongoDB Connection
# For cloud: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# For local: mongodb://127.0.0.1:27017/<dbname>
MONGO_URI=mongodb://127.0.0.1:27017/inventry

# JWT Authentication Secret (generate a strong random string)
JWT_AUTH=your_jwt_secret_here

# Sync Worker Configuration
SYNC_WORKER_ENABLED=false
SYNC_AUTH_TOKEN=your_shared_worker_token_here
SYNC_DEVICE_ID=shop-counter-01
CLOUD_SYNC_URL=http://localhost:5000/api/v1/cloud/sync/bulk
CLOUD_CATALOG_URL=http://localhost:5000/api/v1/cloud/catalog/worker-changes
SYNC_ALLOW_DIRECT_PULL=false
